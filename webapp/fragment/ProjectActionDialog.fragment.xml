<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:gt="com.amt.golivetracker.control"
    xmlns:f="sap.ui.layout.form">

    <!-- The project's "…" actions (controller/projectHeader.js), in two
         modes (action>/mode):
         "status"   ProjectService.changeStatus: the new status and why. Only
                    the allowed transitions pass; the API answers 409 to the
                    others, and to Closing while milestones or audit
                    follow-ups are open, listing them.
         "baseline" ProjectService.setBaseline: saves today's forecast dates
                    as every milestone's baseline (BR-06). -->
    <Dialog
        id="projectActionDialog"
        title="{action>/title}"
        contentWidth="30rem"
        class="sapUiContentPadding">
        <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
            <Text text="{action>/intro}" class="gtSubtle"/>

            <Label text="{i18n>actNewStatus}" labelFor="actionStatus" required="true" visible="{= ${action>/mode} === 'status' }"/>
            <gt:SearchSelect
                id="actionStatus"
                visible="{= ${action>/mode} === 'status' }"
                selectedKey="{action>/values/status}"
                items="{path: 'action>/statuses', templateShareable: false}">
                <core:Item key="{action>key}" text="{action>text}"/>
            </gt:SearchSelect>

            <Label text="{i18n>actReason}" labelFor="actionReason" required="{= ${action>/mode} === 'baseline' }"/>
            <TextArea
                id="actionReason"
                value="{action>/values/reason}"
                valueLiveUpdate="true"
                rows="3"
                growing="true"
                placeholder="{i18n>actReasonPlaceholder}"
                valueState="{= ${action>/errors/reason} ? 'Error' : 'None' }"
                valueStateText="{action>/errors/reason}"/>
        </f:SimpleForm>
        <beginButton>
            <Button text="{action>/confirmText}" type="Emphasized" press=".onConfirmProjectAction" enabled="{= !${action>/busy} }"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onCancelProjectAction"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
