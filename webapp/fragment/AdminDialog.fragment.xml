<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <!-- Nova pessoa / Editar pessoa, Novo cliente / Editar cliente, in the
         "record" model (Admin.controller.js), kind "person" or "client". -->
    <Dialog
        id="recordDialog"
        title="{record>/title}"
        contentWidth="30rem"
        class="sapUiContentPadding">
        <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
            <Label text="{i18n>admName}" labelFor="recName" required="true"/>
            <Input
                id="recName"
                value="{record>/values/name}"
                maxLength="200"
                valueState="{= ${record>/errors/name} ? 'Error' : 'None' }"
                valueStateText="{record>/errors/name}"/>

            <Label text="{i18n>admEmail}" labelFor="recEmail" required="true" visible="{= ${record>/kind} === 'person' }"/>
            <Input
                id="recEmail"
                type="Email"
                visible="{= ${record>/kind} === 'person' }"
                value="{record>/values/email}"
                maxLength="200"
                valueState="{= ${record>/errors/email} ? 'Error' : 'None' }"
                valueStateText="{record>/errors/email}"/>

            <Label text="{i18n>teamColProfile}" labelFor="recProfile" required="true" visible="{= ${record>/kind} === 'person' }"/>
            <SegmentedButton id="recProfile" visible="{= ${record>/kind} === 'person' }" selectedKey="{record>/values/profile}" width="100%">
                <items>
                    <SegmentedButtonItem key="User" text="{i18n>profileUser}"/>
                    <SegmentedButtonItem key="Architect" text="{i18n>profileArchitect}"/>
                    <SegmentedButtonItem key="Administrator" text="{i18n>profileAdministrator}"/>
                </items>
            </SegmentedButton>
            <Text text="{i18n>admProfileHint}" visible="{= ${record>/kind} === 'person' }" class="gtHint"/>

            <Label text="{i18n>admTaxId}" labelFor="recTaxId" visible="{= ${record>/kind} === 'client' }"/>
            <Input
                id="recTaxId"
                visible="{= ${record>/kind} === 'client' }"
                value="{record>/values/taxId}"
                maxLength="9"
                valueState="{= ${record>/errors/taxId} ? 'Error' : 'None' }"
                valueStateText="{record>/errors/taxId}"/>

            <Label text="{i18n>admErpCode}" labelFor="recErp" visible="{= ${record>/kind} === 'client' }"/>
            <Input id="recErp" visible="{= ${record>/kind} === 'client' }" value="{record>/values/erpCode}" maxLength="50"/>

            <Label text="{i18n>teamActive}" labelFor="recActive"/>
            <Switch id="recActive" state="{record>/values/active}" customTextOn=" " customTextOff=" "/>
        </f:SimpleForm>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onSaveRecord" enabled="{= !${record>/busy} }"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onCancelRecord"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
