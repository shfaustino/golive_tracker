<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- Eliminar selecionados (controller/bulkDelete.js), on Projetos,
         Pessoas and Clientes, in the "bulk" model: the selected records, the
         number of them typed to confirm, then how each deletion went; those
         refused for their history (people, clients) can then be deactivated. -->
    <Dialog
        id="bulkDeleteDialog"
        title="{bulk>/title}"
        contentWidth="44rem"
        busy="{bulk>/busy}"
        busyIndicatorDelay="0"
        class="gtApp gtDialog sapUiContentPadding">
        <VBox renderType="Bare" class="gtImport">
            <MessageStrip
                text="{parts: ['bulk>/intro', 'bulk>/count'], formatter: '.formatMessage'}"
                type="Error"
                showIcon="true"
                visible="{= !${bulk>/done} }"/>
            <MessageStrip
                text="{parts: ['i18n>bulkRefused', 'bulk>/refused'], formatter: '.formatMessage'}"
                type="Warning"
                showIcon="true"
                visible="{= ${bulk>/refused} > 0 }"/>
            <Table class="gtTable gtTableInset" items="{bulk>/rows}">
                <columns>
                    <Column width="14rem"><Text text="{bulk>/codeLabel}"/></Column>
                    <Column><Text text="{i18n>colName}"/></Column>
                    <Column width="14rem" visible="{bulk>/done}"><Text text="{i18n>colStatus}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{= ${bulk>code} || '—' }"/>
                            <Text text="{bulk>name}"/>
                            <VBox alignItems="Start" renderType="Bare">
                                <ObjectStatus text="{bulk>stateText}" state="{bulk>state}" inverted="true"/>
                                <Text text="{bulk>message}" visible="{= !!${bulk>message} }" class="gtSubtle"/>
                            </VBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <VBox renderType="Bare" visible="{= !${bulk>/done} }">
                <Label text="{parts: ['i18n>bulkType', 'bulk>/count'], formatter: '.formatMessage'}" labelFor="bulkConfirm" required="true"/>
                <Input id="bulkConfirm" value="{bulk>/typed}" valueLiveUpdate="true" placeholder="{bulk>/count}" width="8rem"/>
            </VBox>
        </VBox>
        <buttons>
            <Button
                text="{parts: ['i18n>bulkDelete', 'bulk>/count'], formatter: '.formatMessage'}"
                type="Reject"
                visible="{= !${bulk>/done} }"
                enabled="{= !${bulk>/busy} &amp;&amp; ${bulk>/typed} === ${bulk>/count} }"
                press=".onConfirmBulkDelete"/>
            <Button
                text="{parts: ['i18n>bulkDeactivate', 'bulk>/refused'], formatter: '.formatMessage'}"
                type="Emphasized"
                visible="{= ${bulk>/refused} > 0 }"
                enabled="{= !${bulk>/busy} }"
                press=".onDeactivateRefused"/>
            <Button text="{= ${bulk>/done} ? ${i18n>close} : ${i18n>cancel} }" press=".onCloseBulkDelete"/>
        </buttons>
    </Dialog>

</core:FragmentDefinition>
