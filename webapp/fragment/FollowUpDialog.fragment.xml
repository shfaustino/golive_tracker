<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:gt="com.amt.golivetracker.control"
    xmlns:f="sap.ui.layout.form">

    <!-- Adicionar follow-up (US-26): ProjectService.addFollowUp on the audit,
         which creates a FollowUp item on the audited milestone. The owner
         has to be an active member of the project's team. -->
    <Dialog
        id="followUpDialog"
        title="{followUp>/title}"
        contentWidth="30rem"
        class="sapUiContentPadding">
        <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
            <Label text="{i18n>fuName}" labelFor="fuName" required="true"/>
            <Input
                id="fuName"
                value="{followUp>/values/name}"
                maxLength="200"
                valueState="{= ${followUp>/errors/name} ? 'Error' : 'None' }"
                valueStateText="{followUp>/errors/name}"/>

            <Label text="{i18n>fuOwner}" labelFor="fuOwner" required="true"/>
            <gt:SearchSelect
                id="fuOwner"
                width="100%"
                selectedKey="{followUp>/values/owner_ID}"
                items="{path: 'followUp>/people', templateShareable: false}"
                valueState="{= ${followUp>/errors/owner_ID} ? 'Error' : 'None' }"
                valueStateText="{followUp>/errors/owner_ID}">
                <core:ListItem key="{followUp>ID}" text="{followUp>name}" additionalText="{followUp>roles}"/>
            </gt:SearchSelect>

            <Label text="{i18n>mwColDate}" labelFor="fuDate" required="true"/>
            <DatePicker
                id="fuDate"
                value="{followUp>/values/date}"
                valueFormat="yyyy-MM-dd"
                displayFormat="dd/MM/yyyy"
                valueState="{= ${followUp>/errors/date} ? 'Error' : 'None' }"
                valueStateText="{followUp>/errors/date}"/>

            <Label text="{i18n>pfDescription}" labelFor="fuDescription"/>
            <TextArea id="fuDescription" value="{followUp>/values/description}" rows="2" growing="true" width="100%"/>
        </f:SimpleForm>
        <beginButton>
            <Button text="{i18n>fuAdd}" type="Emphasized" press=".onSaveFollowUp" enabled="{= !${followUp>/busy} }"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onCancelFollowUp"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
