<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <!-- Importar pessoas / clientes / módulos / tipos de marco
         (controller/adminBulk.js), in the "import" model (kind, and the
         texts of the tab on show): the template, the chosen
         file, and every row of it checked before the valid ones are created. -->
    <Dialog
        id="adminImportDialog"
        title="{import>/title}"
        contentWidth="56rem"
        resizable="true"
        busy="{import>/busy}"
        busyIndicatorDelay="0"
        class="gtApp gtDialog sapUiContentPadding">
        <VBox renderType="Bare" class="gtImport">
            <Text text="{import>/intro}" class="gtSubtle"/>
            <HBox alignItems="Center" renderType="Bare" class="gtImportActions">
                <Button text="{i18n>impTemplate}" icon="sap-icon://download" press=".onDownloadRecordsTemplate"/>
                <!-- picks the file only: it is read in the browser, never uploaded as it is -->
                <u:FileUploader
                    buttonOnly="true"
                    buttonText="{i18n>impChoose}"
                    icon="sap-icon://upload"
                    fileType="xlsx,xls,csv"
                    sameFilenameAllowed="true"
                    enabled="{= !${import>/done} }"
                    change=".onChooseRecordsFile"/>
                <Text text="{import>/fileName}" class="gtSubtle"/>
            </HBox>
            <MessageStrip
                text="{parts: ['i18n>impSummary', 'import>/ready', 'import>/wrong'], formatter: '.formatMessage'}"
                type="{= ${import>/wrong} > 0 ? 'Warning' : 'Information' }"
                showIcon="true"
                visible="{= ${import>/rows}.length > 0 &amp;&amp; !${import>/done} }"/>
            <Table class="gtTable gtTableInset" visible="{= ${import>/rows}.length > 0 }" items="{import>/rows}">
                <columns>
                    <Column width="3.5rem"><Text text="{i18n>impLine}"/></Column>
                    <Column><Text text="{i18n>admName}"/></Column>
                    <Column><Text text="{import>/detailLabel}"/></Column>
                    <Column width="9rem" visible="{= !!${import>/extraLabel} }"><Text text="{import>/extraLabel}"/></Column>
                    <Column width="20rem"><Text text="{i18n>colStatus}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{import>line}"/>
                            <Text text="{import>name}"/>
                            <Text text="{= ${import>detail} || '—' }"/>
                            <Text text="{= ${import>/kind} === 'person' ? ${path: 'import>extra', formatter: '.formatter.profileText'} : (${import>extra} || '—') }"/>
                            <VBox alignItems="Start" renderType="Bare">
                                <ObjectStatus text="{import>stateText}" state="{import>state}" inverted="true"/>
                                <Text text="{import>message}" visible="{= !!${import>message} }" class="gtSubtle gtPreLine"/>
                            </VBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <beginButton>
            <Button
                text="{parts: ['i18n>impCreateRecords', 'import>/ready'], formatter: '.formatMessage'}"
                type="Emphasized"
                enabled="{= ${import>/ready} > 0 &amp;&amp; !${import>/busy} &amp;&amp; !${import>/done} }"
                press=".onConfirmRecordsImport"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>close}" press=".onCloseRecordsImport"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
