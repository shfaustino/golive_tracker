<mvc:View
    controllerName="com.amt.golivetracker.controller.ProjectCreate"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:gt="com.amt.golivetracker.control"
    xmlns:mvc="sap.ui.core.mvc">

    <!-- Novo projeto (docs/mockups/06-novo-projeto.png), US-01 to US-03:
         one POST /project/Projects with the modules and the initial team
         (deep insert). The form lives in the "form" model
         (ProjectCreate.controller.js) and model/projectForm.js checks it.

         Where the mockup and the API differ, the API wins: the status is
         not set here (a project starts Não iniciado and moves through Mudar
         estado), and the team has no availability.
         The milestones are generated by the API from the project type; the
         card on the right shows which. -->
    <Page id="projectCreatePage" showHeader="false" class="gtPage" busy="{form>/busy}" busyIndicatorDelay="0">
        <VBox class="gtPageContent" renderType="Bare">
            <Breadcrumbs currentLocationText="{i18n>newProject}" separatorStyle="GreaterThan" class="gtBreadcrumbs">
                <Link text="{i18n>navProjects}" press=".onCancel"/>
            </Breadcrumbs>

            <HBox class="gtPageHeader" renderType="Bare">
                <Title text="{i18n>newProject}" level="H1" class="gtPageTitle"/>
                <HBox class="gtHeaderButtons" renderType="Bare">
                    <Button text="{i18n>cancel}" press=".onCancel" class="gtSecondaryButton"/>
                    <Button
                        id="saveProjectButton"
                        text="{i18n>save}"
                        icon="sap-icon://save"
                        type="Emphasized"
                        press=".onSave"
                        class="gtPrimaryButton"/>
                </HBox>
            </HBox>

            <HBox class="gtCreateGrid" renderType="Bare">
                <VBox class="gtCreateMain" renderType="Bare">
                    <!-- Informação geral -->
                    <VBox class="gtCard gtCardBody" renderType="Bare">
                        <Title text="{i18n>pfGeneral}" level="H2" class="gtSectionTitle gtFormTitle"/>
                        <HBox class="gtFormGrid" renderType="Bare">
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>colCode}" labelFor="pfCode" required="true"/>
                                <Input
                                    id="pfCode"
                                    value="{form>/values/code}"
                                    placeholder="CO-N-04000"
                                    maxLength="20"
                                    valueState="{= ${form>/errors/code} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/code}"/>
                                <Text text="{i18n>pfCodeHint}" class="gtHint"/>
                            </VBox>
                            <VBox class="gtField gtFieldWide" renderType="Bare">
                                <Label text="{i18n>pfName}" labelFor="pfName" required="true"/>
                                <Input
                                    id="pfName"
                                    value="{form>/values/name}"
                                    maxLength="200"
                                    valueState="{= ${form>/errors/name} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/name}"/>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>colClient}" labelFor="pfClient" required="true"/>
                                <gt:SearchSelect
                                    id="pfClient"
                                    width="100%"
                                    selectedKey="{form>/values/client_ID}"
                                    items="{path: 'form>/clients', templateShareable: false}"
                                    valueState="{= ${form>/errors/client_ID} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/client_ID}">
                                    <core:ListItem key="{form>ID}" text="{form>name}"/>
                                </gt:SearchSelect>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectType}" labelFor="pfType" required="true"/>
                                <gt:SearchSelect
                                    id="pfType"
                                    width="100%"
                                    selectedKey="{form>/values/projectType}"
                                    change=".onTypeChange"
                                    items="{path: 'form>/types', templateShareable: false}"
                                    valueState="{= ${form>/errors/projectType} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/projectType}">
                                    <core:Item key="{form>key}" text="{form>text}"/>
                                </gt:SearchSelect>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectExternalCode}" labelFor="pfExternal"/>
                                <Input id="pfExternal" value="{form>/values/externalCode}" maxLength="40"
                                    valueState="{= ${form>/errors/externalCode} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/externalCode}"/>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectCurrency}" labelFor="pfCurrency" required="true"/>
                                <gt:SearchSelect
                                    id="pfCurrency"
                                    width="100%"
                                    selectedKey="{form>/values/currency_code}"
                                    items="{path: 'form>/currencies', templateShareable: false}"
                                    valueState="{= ${form>/errors/currency_code} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/currency_code}">
                                    <core:Item key="{form>code}" text="{form>label}"/>
                                </gt:SearchSelect>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectStartDate}" labelFor="pfStart" required="true"/>
                                <DatePicker
                                    id="pfStart"
                                    value="{form>/values/startDate}"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd/MM/yyyy"
                                    valueState="{= ${form>/errors/startDate} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/startDate}"/>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectEndDate}" labelFor="pfEnd" required="true"/>
                                <DatePicker
                                    id="pfEnd"
                                    value="{form>/values/endDate}"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd/MM/yyyy"
                                    valueState="{= ${form>/errors/endDate} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/endDate}"/>
                            </VBox>
                            <VBox class="gtField" renderType="Bare">
                                <Label text="{i18n>projectValue}" labelFor="pfValue"/>
                                <Input
                                    id="pfValue"
                                    type="Number"
                                    value="{form>/values/value}"
                                    description="{form>/values/currency_code}"
                                    fieldWidth="80%"
                                    valueState="{= ${form>/errors/value} ? 'Error' : 'None' }"
                                    valueStateText="{form>/errors/value}"/>
                            </VBox>
                            <VBox class="gtField gtFieldFull" renderType="Bare">
                                <Label text="{i18n>pfDescription}" labelFor="pfDescription"/>
                                <TextArea
                                    id="pfDescription"
                                    value="{form>/values/description}"
                                    rows="3"
                                    growing="true"
                                    growingMaxLines="8"
                                    width="100%"
                                    maxLength="1000"
                                    showExceededText="false"
                                    valueLiveUpdate="true"/>
                                <Text text="{= (${form>/values/description} || '').length + '/1000' }" class="gtHint gtCounter"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Módulos -->
                    <VBox class="gtCard gtCardBody" renderType="Bare">
                        <Title text="{i18n>tabModules}" level="H2" class="gtSectionTitle"/>
                        <Text text="{i18n>pfModulesHint}" class="gtSubtle gtFormSubtitle"/>
                        <MultiComboBox
                            id="pfModules"
                            width="100%"
                            selectedKeys="{form>/values/modules}"
                            items="{path: 'form>/modules', templateShareable: false}">
                            <core:ListItem key="{form>key}" text="{form>text}" additionalText="{form>name}"/>
                        </MultiComboBox>
                    </VBox>

                    <!-- Equipa inicial -->
                    <VBox class="gtCard gtTableCard" renderType="Bare">
                        <HBox class="gtCardHeader" renderType="Bare">
                            <VBox renderType="Bare">
                                <Title text="{i18n>pfTeam}" level="H2" class="gtSectionTitle"/>
                                <Text text="{i18n>pfTeamHint}" class="gtSubtle"/>
                            </VBox>
                            <Button text="{i18n>pfAddPerson}" icon="sap-icon://add" press=".onAddRow" class="gtOutlineButton"/>
                        </HBox>
                        <Table
                            id="pfTeamTable"
                            class="gtTable gtTableInset"
                            fixedLayout="false"
                            noDataText="{i18n>pfTeamEmpty}"
                            items="{form>/values/members}">
                            <columns>
                                <Column><Text text="{i18n>teamColPerson}"/></Column>
                                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>teamColProfile}"/></Column>
                                <Column><Text text="{i18n>pfRoleInProject}"/></Column>
                                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>teamColFrom}"/></Column>
                                <Column width="4rem" hAlign="Center"><Text text="{i18n>colActions}"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem highlight="{= ${form>error} ? 'Error' : 'None' }">
                                    <cells>
                                        <gt:SearchSelect
                                            width="100%"
                                            selectedKey="{form>person_ID}"
                                            selectionChange=".onRowPersonChange"
                                            placeholder="{i18n>pfChoosePerson}"
                                            valueState="{= ${form>error} ? 'Error' : 'None' }"
                                            valueStateText="{form>error}"
                                            items="{path: 'form>/people', templateShareable: false}">
                                            <core:ListItem key="{form>ID}" text="{form>name}" additionalText="{form>email}"/>
                                        </gt:SearchSelect>
                                        <Text text="{path: 'form>profile', formatter: '.formatter.profileText'}" wrapping="false"/>
                                        <gt:SearchSelect width="100%" selectedKey="{form>role}" items="{path: 'form>/roles', templateShareable: false}">
                                            <core:Item key="{form>key}" text="{form>text}"/>
                                        </gt:SearchSelect>
                                        <DatePicker
                                            value="{form>startDate}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd/MM/yyyy"
                                            placeholder="{i18n>pfSameAsProject}"/>
                                        <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>teamRemove}" press=".onRemoveRow"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Text text="{i18n>pfTeamNote}" class="gtSubtle gtTableNote"/>
                    </VBox>
                </VBox>

                <!-- What the API will generate from the type -->
                <VBox class="gtCard gtCardBody gtCreateSide" renderType="Bare">
                    <Title text="{i18n>pfMilestonesTitle}" level="H2" class="gtSectionTitle"/>
                    <Text text="{i18n>pfMilestonesHint}" class="gtSubtle gtFormSubtitle"/>
                    <VBox items="{form>/milestones}" renderType="Bare" class="gtMiniList">
                        <HBox class="gtMiniRow" alignItems="Center" renderType="Bare">
                            <HBox class="gtStepDot gtStepDotSmall" renderType="Bare"/>
                            <Text text="{path: 'form>milestoneType', formatter: '.formatter.milestoneTypeText'}" class="gtMiniTitle"/>
                            <ObjectStatus text="{i18n>pfAudit}" state="Warning" inverted="true" visible="{form>audit}" class="gtPushRight"/>
                        </HBox>
                    </VBox>
                    <Text
                        text="{= ${form>/values/projectType} ? ${i18n>pfNoMilestones} : ${i18n>pfChooseType} }"
                        visible="{= ${form>/milestones}.length === 0 }"
                        class="gtSubtle"/>
                </VBox>
            </HBox>
        </VBox>
    </Page>

</mvc:View>
