<mvc:View
    controllerName="com.amt.golivetracker.controller.BaseController"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">

    <!-- Stands in for the pages not built yet (manifest.json targets whose
         viewName is "Placeholder"). Each is replaced by its own view as its
         mockup in docs/mockups is implemented. -->
    <Page id="placeholderPage" showHeader="false" class="gtPage">
        <IllustratedMessage
            illustrationType="sapIllus-SimpleConstruction"
            title="{i18n>placeholderTitle}"
            description="{i18n>placeholderDescription}"/>
    </Page>

</mvc:View>
