<mvc:View
    controllerName="com.amt.golivetracker.controller.ProjectDetail"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc">

    <!-- Projeto (docs/mockups/04-projeto-marcos.png): the project's header
         and its areas as tabs. The view is bound to /Projects(<id>) by the
         controller; the tab is part of the route (Projetos/<id>/<tab>), so a
         link or the back button lands on the same tab. -->
    <Page id="projectDetailPage" showHeader="false" class="gtPage" busy="{detail>/busy}" busyIndicatorDelay="0">
        <VBox class="gtPageContent">
            <Breadcrumbs currentLocationText="{code}" class="sapUiSmallMarginBottom">
                <Link text="{i18n>navProjects}" press=".onNavToProjects"/>
            </Breadcrumbs>

            <HBox justifyContent="SpaceBetween" alignItems="Start" class="gtPageHeader">
                <VBox>
                    <Title text="{code}" level="H1" titleStyle="H1"/>
                    <Text text="{name}" class="gtProjectName"/>
                </VBox>
                <ObjectStatus
                    text="{path: 'status', formatter: '.formatter.projectStatusText'}"
                    state="{path: 'status', formatter: '.formatter.projectStatusState'}"
                    inverted="true"
                    class="gtProjectStatus"/>
            </HBox>

            <HBox wrap="Wrap" renderType="Bare" class="gtProjectFacts">
                <VBox class="gtProjectFact">
                    <Label text="{i18n>colClient}"/>
                    <Text text="{client/name}"/>
                </VBox>
                <VBox class="gtProjectFact">
                    <Label text="{i18n>projectCurrency}"/>
                    <Text text="{currency_code}"/>
                </VBox>
                <VBox class="gtProjectFact">
                    <Label text="{i18n>projectStartDate}"/>
                    <Text text="{path: 'startDate', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}"/>
                </VBox>
                <VBox class="gtProjectFact">
                    <Label text="{i18n>projectEndDate}"/>
                    <Text text="{path: 'endDate', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}"/>
                </VBox>
                <VBox class="gtProjectFact">
                    <Label text="{i18n>projectPm}"/>
                    <Text text="{pm/person/name}"/>
                </VBox>
            </HBox>

            <IconTabBar
                id="projectTabs"
                selectedKey="{detail>/tab}"
                select=".onTabSelect"
                expandable="false"
                headerBackgroundDesign="Transparent"
                backgroundDesign="Transparent"
                applyContentPadding="false"
                class="gtProjectTabs">
                <items>
                    <IconTabFilter key="visao-geral" text="{i18n>tabOverview}">
                        <f:SimpleForm
                            editable="false"
                            layout="ColumnLayout"
                            columnsM="2"
                            columnsL="2"
                            columnsXL="2"
                            class="gtCard">
                            <Label text="{i18n>projectType}"/>
                            <Text text="{projectType}"/>
                            <Label text="{i18n>projectExternalCode}"/>
                            <Text text="{externalCode}"/>
                            <Label text="{i18n>projectValue}"/>
                            <Text text="{value} {currency_code}"/>
                            <Label text="{i18n>projectLastUpdate}"/>
                            <Text text="{path: 'lastUpdateAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {pattern: 'dd/MM/yyyy HH:mm'}}"/>
                            <Label text="{i18n>projectReviewReason}" visible="{= !!${needsReview} }"/>
                            <ObjectStatus text="{reviewReason}" state="Warning" visible="{= !!${needsReview} }"/>
                        </f:SimpleForm>
                    </IconTabFilter>

                    <IconTabFilter key="marcos" text="{i18n>tabMilestones}">
                        <HBox wrap="Wrap" renderType="Bare" class="gtKpiRow">
                            <VBox class="gtCard gtKpi">
                                <ObjectNumber number="{detail>/summary/total}" class="gtKpiNumber"/>
                                <Text text="{i18n>msKpiTotal}"/>
                            </VBox>
                            <VBox class="gtCard gtKpi">
                                <ObjectNumber number="{detail>/summary/completed}" unit="{= ${detail>/summary/completedPct} + '%' }" class="gtKpiNumber"/>
                                <Text text="{i18n>msKpiCompleted}"/>
                            </VBox>
                            <VBox class="gtCard gtKpi">
                                <ObjectNumber number="{detail>/summary/inProgress}" unit="{= ${detail>/summary/inProgressPct} + '%' }" class="gtKpiNumber"/>
                                <Text text="{i18n>msKpiInProgress}"/>
                            </VBox>
                            <VBox class="gtCard gtKpi">
                                <ObjectNumber
                                    number="{detail>/summary/overdue}"
                                    unit="{= ${detail>/summary/overduePct} + '%' }"
                                    state="{= ${detail>/summary/overdue} > 0 ? 'Error' : 'None' }"
                                    class="gtKpiNumber"/>
                                <Text text="{i18n>msKpiOverdue}"/>
                            </VBox>
                            <VBox class="gtCard gtKpi">
                                <ObjectNumber number="{detail>/summary/notStarted}" unit="{= ${detail>/summary/notStartedPct} + '%' }" class="gtKpiNumber"/>
                                <Text text="{i18n>msKpiNotStarted}"/>
                            </VBox>
                        </HBox>

                        <Table
                            id="milestonesTable"
                            class="gtCard"
                            noDataText="{i18n>msNoData}"
                            updateFinished=".onMilestonesUpdated"
                            items="{
                                path: 'milestones',
                                parameters: {
                                    $expand: 'owners($expand=person($select=name))',
                                    $orderby: 'sortOrder'
                                }
                            }">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>msTitle}" level="H2"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="{i18n>colMilestone}"/></Column>
                                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>msColForecast}"/></Column>
                                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>msColActual}"/></Column>
                                <Column width="10rem"><Text text="{i18n>colStatus}"/></Column>
                                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>msColOwners}"/></Column>
                                <Column width="4rem" hAlign="End"><Text text="{i18n>colActions}"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <VBox>
                                            <Text text="{path: 'milestoneType', formatter: '.formatter.milestoneTypeText'}"/>
                                            <Text text="{i18n>msEstimated}" visible="{= !!${isEstimated} }" class="gtSubtle"/>
                                        </VBox>
                                        <Text text="{path: 'forecastEnd', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}"/>
                                        <Text text="{path: 'actualDate', formatter: '.formatter.dateOrDash'}"/>
                                        <ObjectStatus
                                            text="{= ${isOverdue} ? ${i18n>msOverdue} : ${path: 'status', formatter: '.formatter.milestoneStatusText'} }"
                                            state="{parts: ['status', 'isOverdue'], formatter: '.formatter.milestoneStatusState'}"
                                            inverted="true"/>
                                        <HBox items="{path: 'owners', templateShareable: false}" renderType="Bare" class="gtOwners">
                                            <Avatar
                                                displaySize="XS"
                                                initials="{path: 'person/name', formatter: '.formatter.initials'}"
                                                tooltip="{person/name}"/>
                                        </HBox>
                                        <Button
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="{i18n>msEdit}"
                                            press=".onEditMilestone"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="equipa" text="{i18n>tabTeam}">
                        <IllustratedMessage illustrationType="sapIllus-SimpleConstruction" title="{i18n>placeholderTitle}" description="{i18n>placeholderDescription}"/>
                    </IconTabFilter>
                    <IconTabFilter key="modulos" text="{i18n>tabModules}">
                        <IllustratedMessage illustrationType="sapIllus-SimpleConstruction" title="{i18n>placeholderTitle}" description="{i18n>placeholderDescription}"/>
                    </IconTabFilter>
                    <IconTabFilter key="auditorias" text="{i18n>navAudits}">
                        <IllustratedMessage illustrationType="sapIllus-SimpleConstruction" title="{i18n>placeholderTitle}" description="{i18n>placeholderDescription}"/>
                    </IconTabFilter>
                    <IconTabFilter key="anexos" text="{i18n>navAttachments}">
                        <IllustratedMessage illustrationType="sapIllus-SimpleConstruction" title="{i18n>placeholderTitle}" description="{i18n>placeholderDescription}"/>
                    </IconTabFilter>
                    <IconTabFilter key="updates" text="{i18n>tabUpdates}">
                        <IllustratedMessage illustrationType="sapIllus-SimpleConstruction" title="{i18n>placeholderTitle}" description="{i18n>placeholderDescription}"/>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </VBox>
    </Page>

</mvc:View>
