<mvc:View
    controllerName="com.amt.golivetracker.controller.Admin"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:gt="com.amt.golivetracker.control"
    xmlns:mvc="sap.ui.core.mvc">

    <!-- Pessoas e Clientes (docs/mockups/09-administracao-pessoas.png),
         US-07, US-08: one page for the routes Pessoas, Clientes and
         Administração. An Administrator manages both through /admin (every
         record, inactive ones too, with profile and status); everyone else
         sees the active ones read-only, through /project. A page at a time,
         in the "dir" model (Admin.controller.js). -->
    <Page id="adminPage" showHeader="false" class="gtPage">
        <VBox class="gtPageContent" renderType="Bare">
            <Breadcrumbs currentLocationText="{dir>/title}" separatorStyle="GreaterThan" class="gtBreadcrumbs" visible="{user>/isAdmin}">
                <Link text="{i18n>navAdmin}" press=".onTabPeople"/>
            </Breadcrumbs>

            <HBox class="gtPageHeader" alignItems="Start" renderType="Bare">
                <VBox renderType="Bare">
                    <Title text="{dir>/title}" level="H1" class="gtPageTitle"/>
                    <Text text="{dir>/subtitle}" class="gtSubtitle"/>
                </VBox>
                <!-- Administrators: many at a time (controller/adminBulk.js), and one -->
                <HBox alignItems="Center" renderType="Bare" class="gtHeaderButtons" visible="{user>/isAdmin}">
                    <Button
                        id="deleteSelectedRecordsButton"
                        text="{parts: ['i18n>bulkOpen', 'dir>/selectedCount'], formatter: '.formatMessage'}"
                        icon="sap-icon://delete"
                        type="Reject"
                        visible="{= ${dir>/selectedCount} > 0 }"
                        press=".onDeleteSelected"/>
                    <Button
                        id="importRecordsButton"
                        text="{i18n>impOpen}"
                        icon="sap-icon://excel-attachment"
                        press=".onImportRecords"/>
                    <Button
                        id="newRecordButton"
                        text="{dir>/newText}"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onNew"
                        class="gtPrimaryButton"/>
                </HBox>
            </HBox>

            <IconTabBar
                id="adminTabs"
                selectedKey="{dir>/tab}"
                select=".onTabSelect"
                expandable="false"
                headerMode="Inline"
                headerBackgroundDesign="Transparent"
                backgroundDesign="Transparent"
                applyContentPadding="false"
                class="gtProjectTabs">
                <items>
                    <IconTabFilter key="pessoas" text="{i18n>navPeople}"/>
                    <IconTabFilter key="clientes" text="{i18n>navClients}"/>
                    <!-- the managed lists (model/lists.js): Administrators only -->
                    <IconTabFilter key="modulos" text="{i18n>admModules}" visible="{user>/isAdmin}"/>
                    <IconTabFilter key="tipos" text="{i18n>admTypes}" visible="{user>/isAdmin}"/>
                </items>
            </IconTabBar>

            <HBox class="gtAdminFilters" alignItems="End" renderType="Bare">
                <SearchField
                    id="dirSearch"
                    placeholder="{= ${dir>/tab} === 'pessoas' ? ${i18n>admSearchPeople} : (${dir>/tab} === 'clientes' ? ${i18n>admSearchClients} : ${i18n>admSearchCodes}) }"
                    search=".onSearch"
                    liveChange=".onSearch"
                    showSearchButton="false"
                    class="gtFilterSearch"/>
                <VBox class="gtFilterField" renderType="Bare" visible="{= ${dir>/tab} === 'pessoas' }">
                    <Label text="{i18n>teamColProfile}" labelFor="profileFilter" class="gtFilterLabel"/>
                    <gt:SearchSelect id="profileFilter" width="100%" selectedKey="{dir>/profile}" selectionChange=".onFilterChange"
                        placeholder="{i18n>filterAll}" showClearIcon="true">
                        <core:Item key="Administrator" text="{i18n>profileAdministrator}"/>
                        <core:Item key="Architect" text="{i18n>profileArchitect}"/>
                        <core:Item key="User" text="{i18n>profileUser}"/>
                    </gt:SearchSelect>
                </VBox>
                <VBox class="gtFilterField" renderType="Bare" visible="{user>/isAdmin}">
                    <Label text="{i18n>colStatus}" labelFor="activeFilter" class="gtFilterLabel"/>
                    <gt:SearchSelect id="activeFilter" width="100%" selectedKey="{dir>/state}" selectionChange=".onFilterChange"
                        placeholder="{i18n>filterAll}" showClearIcon="true">
                        <core:Item key="active" text="{i18n>teamActive}"/>
                        <core:Item key="inactive" text="{i18n>teamInactive}"/>
                    </gt:SearchSelect>
                </VBox>
            </HBox>

            <VBox class="gtCard gtTableCard" renderType="Bare">
                <!-- Pessoas -->
                <Table
                    id="peopleTable"
                    class="gtTable"
                    fixedLayout="false"
                    mode="{= ${user>/isAdmin} ? 'MultiSelect' : 'None' }"
                    selectionChange=".onBulkSelectionChange"
                    visible="{= ${dir>/tab} === 'pessoas' }"
                    busy="{dir>/busy}"
                    busyIndicatorDelay="0"
                    noDataText="{i18n>admNoPeople}"
                    items="{dir>/rows}">
                    <columns>
                        <Column><Text text="{i18n>admName}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>admEmail}"/></Column>
                        <Column><Text text="{i18n>teamColProfile}"/></Column>
                        <Column visible="{user>/isAdmin}"><Text text="{i18n>colStatus}"/></Column>
                        <Column width="4rem" hAlign="Center" visible="{user>/isAdmin}"/>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <HBox alignItems="Center" renderType="Bare" class="gtPersonCell">
                                    <Avatar displaySize="S" initials="{path: 'dir>name', formatter: '.formatter.initials'}" class="gtPersonAvatar"/>
                                    <Text text="{dir>name}"/>
                                </HBox>
                                <Link text="{dir>email}" href="{= 'mailto:' + ${dir>email} }"/>
                                <Text text="{path: 'dir>profile', formatter: '.formatter.profileText'}"/>
                                <ObjectStatus
                                    text="{= ${dir>active} !== false ? ${i18n>teamActive} : ${i18n>teamInactive} }"
                                    state="{= ${dir>active} !== false ? 'Success' : 'Error' }"
                                    inverted="true"/>
                                <Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>admActions}" press=".onRowActions" class="gtRowAction"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Clientes -->
                <Table
                    id="clientsTable"
                    class="gtTable"
                    fixedLayout="false"
                    mode="{= ${user>/isAdmin} ? 'MultiSelect' : 'None' }"
                    selectionChange=".onBulkSelectionChange"
                    visible="{= ${dir>/tab} === 'clientes' }"
                    busy="{dir>/busy}"
                    busyIndicatorDelay="0"
                    noDataText="{i18n>admNoClients}"
                    items="{dir>/rows}">
                    <columns>
                        <Column><Text text="{i18n>admName}"/></Column>
                        <Column visible="{user>/isAdmin}"><Text text="{i18n>admTaxId}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>admErpCode}"/></Column>
                        <Column visible="{user>/isAdmin}"><Text text="{i18n>colStatus}"/></Column>
                        <Column width="4rem" hAlign="Center" visible="{user>/isAdmin}"/>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <HBox alignItems="Center" renderType="Bare" class="gtPersonCell">
                                    <HBox class="gtFeedIcon gtTintBlue" renderType="Bare"><core:Icon src="sap-icon://building"/></HBox>
                                    <Text text="{dir>name}"/>
                                </HBox>
                                <Text text="{= ${dir>taxId} || '—' }"/>
                                <Text text="{= ${dir>erpCode} || '—' }"/>
                                <ObjectStatus
                                    text="{= ${dir>active} !== false ? ${i18n>teamActive} : ${i18n>teamInactive} }"
                                    state="{= ${dir>active} !== false ? 'Success' : 'Error' }"
                                    inverted="true"/>
                                <Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>admActions}" press=".onRowActions" class="gtRowAction"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Módulos (Administrators only) -->
                <Table
                    id="modulesTable"
                    class="gtTable"
                    fixedLayout="false"
                    mode="MultiSelect"
                    selectionChange=".onBulkSelectionChange"
                    visible="{= ${dir>/tab} === 'modulos' }"
                    busy="{dir>/busy}"
                    busyIndicatorDelay="0"
                    noDataText="{i18n>admNoModules}"
                    items="{dir>/rows}">
                    <columns>
                        <Column width="12rem"><Text text="{i18n>admCode}"/></Column>
                        <Column><Text text="{i18n>admName}"/></Column>
                        <Column><Text text="{i18n>colStatus}"/></Column>
                        <Column width="4rem" hAlign="Center"/>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectStatus text="{dir>code}" state="Information" inverted="true"/>
                                <Text text="{dir>name}"/>
                                <ObjectStatus
                                    text="{= ${dir>active} !== false ? ${i18n>teamActive} : ${i18n>teamInactive} }"
                                    state="{= ${dir>active} !== false ? 'Success' : 'Error' }"
                                    inverted="true"/>
                                <Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>admActions}" press=".onRowActions" class="gtRowAction"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Tipos de marco (Administrators only), in timeline order -->
                <Table
                    id="typesTable"
                    class="gtTable"
                    fixedLayout="false"
                    mode="MultiSelect"
                    selectionChange=".onBulkSelectionChange"
                    visible="{= ${dir>/tab} === 'tipos' }"
                    busy="{dir>/busy}"
                    busyIndicatorDelay="0"
                    noDataText="{i18n>admNoTypes}"
                    items="{dir>/rows}">
                    <columns>
                        <Column width="12rem"><Text text="{i18n>admCode}"/></Column>
                        <Column><Text text="{i18n>admName}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>admRequiresAudit}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" width="6rem"><Text text="{i18n>admOrder}"/></Column>
                        <Column><Text text="{i18n>colStatus}"/></Column>
                        <Column width="4rem" hAlign="Center"/>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectStatus text="{dir>code}" state="Information" inverted="true"/>
                                <Text text="{dir>name}"/>
                                <Text text="{= ${dir>requiresAudit} ? ${i18n>yes} : ${i18n>no} }"/>
                                <Text text="{dir>sortOrder}"/>
                                <ObjectStatus
                                    text="{= ${dir>active} !== false ? ${i18n>teamActive} : ${i18n>teamInactive} }"
                                    state="{= ${dir>active} !== false ? 'Success' : 'Error' }"
                                    inverted="true"/>
                                <Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>admActions}" press=".onRowActions" class="gtRowAction"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox class="gtTableFooter" justifyContent="SpaceBetween" alignItems="Center" renderType="Bare">
                    <Text text="{dir>/rangeText}" class="gtSubtle"/>
                    <HBox class="gtPager" alignItems="Center" renderType="Bare" visible="{= ${dir>/pageCount} > 1 }">
                        <Button icon="sap-icon://slim-arrow-left" tooltip="{i18n>pagePrevious}" enabled="{= ${dir>/page} > 1 }" press=".onPagePrevious" class="gtPagerButton"/>
                        <HBox items="{dir>/pages}" renderType="Bare" class="gtPagerPages">
                            <Button text="{dir>n}" type="{= ${dir>current} ? 'Emphasized' : 'Default' }" press=".onPagePress" class="gtPagerButton"/>
                        </HBox>
                        <Button icon="sap-icon://slim-arrow-right" tooltip="{i18n>pageNext}" enabled="{= ${dir>/page} &lt; ${dir>/pageCount} }" press=".onPageNext" class="gtPagerButton"/>
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </Page>

</mvc:View>
