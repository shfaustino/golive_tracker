<mvc:View
    controllerName="com.amt.golivetracker.controller.BaseController"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">

    <Page id="notFoundPage" showHeader="false" class="gtPage">
        <IllustratedMessage
            illustrationType="sapIllus-PageNotFound"
            title="{i18n>notFoundTitle}"
            description="{i18n>notFoundDescription}"/>
    </Page>

</mvc:View>
