<?xml version="1.0" encoding="utf-8"?>
<!-- A stand-in for the API's /project/$metadata, for `npm run start-mock`
     only. Field names follow the API's own reference
     (docs/api/ProjectService.openapi.json); it holds just what the app
     reads, and the real /project/$metadata wins whenever the two differ.
     Two liberties for the mock's sake: keys where the API has none of its
     own (ProjectModules, MilestoneOwners), and pm_ID behind the pm
     navigation, which the API resolves itself. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="ProjectService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Projects" EntityType="ProjectService.Projects">
          <NavigationPropertyBinding Path="client" Target="Clients"/>
          <NavigationPropertyBinding Path="pm" Target="Members"/>
          <NavigationPropertyBinding Path="members" Target="Members"/>
          <NavigationPropertyBinding Path="milestones" Target="Milestones"/>
          <NavigationPropertyBinding Path="modules" Target="ProjectModules"/>
          <NavigationPropertyBinding Path="updates" Target="Updates"/>
          <NavigationPropertyBinding Path="attachments" Target="Attachments"/>
        </EntitySet>
        <EntitySet Name="Updates" EntityType="ProjectService.Updates">
          <NavigationPropertyBinding Path="project" Target="Projects"/>
          <NavigationPropertyBinding Path="author" Target="People"/>
        </EntitySet>
        <EntitySet Name="Members" EntityType="ProjectService.Members">
          <NavigationPropertyBinding Path="person" Target="People"/>
          <NavigationPropertyBinding Path="project" Target="Projects"/>
        </EntitySet>
        <EntitySet Name="Milestones" EntityType="ProjectService.Milestones">
          <NavigationPropertyBinding Path="project" Target="Projects"/>
          <NavigationPropertyBinding Path="owners" Target="MilestoneOwners"/>
          <NavigationPropertyBinding Path="audits" Target="Audits"/>
          <NavigationPropertyBinding Path="items" Target="MilestoneItems"/>
          <NavigationPropertyBinding Path="attachments" Target="Attachments"/>
        </EntitySet>
        <EntitySet Name="Audits" EntityType="ProjectService.Audits">
          <NavigationPropertyBinding Path="milestone" Target="Milestones"/>
          <NavigationPropertyBinding Path="auditor" Target="People"/>
          <NavigationPropertyBinding Path="followUps" Target="MilestoneItems"/>
        </EntitySet>
        <EntitySet Name="MilestoneItems" EntityType="ProjectService.MilestoneItems">
          <NavigationPropertyBinding Path="milestone" Target="Milestones"/>
          <NavigationPropertyBinding Path="owner" Target="People"/>
          <NavigationPropertyBinding Path="audit" Target="Audits"/>
          <NavigationPropertyBinding Path="attachments" Target="Attachments"/>
        </EntitySet>
        <EntitySet Name="MilestoneOwners" EntityType="ProjectService.MilestoneOwners">
          <NavigationPropertyBinding Path="person" Target="People"/>
          <NavigationPropertyBinding Path="milestone" Target="Milestones"/>
        </EntitySet>
        <EntitySet Name="ProjectModules" EntityType="ProjectService.ProjectModules">
          <NavigationPropertyBinding Path="project" Target="Projects"/>
        </EntitySet>
        <EntitySet Name="Attachments" EntityType="ProjectService.Attachments">
          <NavigationPropertyBinding Path="author" Target="People"/>
        </EntitySet>
        <EntitySet Name="AllAttachments" EntityType="ProjectService.AllAttachments">
          <NavigationPropertyBinding Path="author" Target="People"/>
          <NavigationPropertyBinding Path="milestoneItem" Target="MilestoneItems"/>
        </EntitySet>
        <EntitySet Name="RecentUpdates" EntityType="ProjectService.RecentUpdates"/>
        <EntitySet Name="MyItems" EntityType="ProjectService.MyItems"/>
        <EntitySet Name="MyMilestones" EntityType="ProjectService.MyMilestones"/>
        <EntitySet Name="Clients" EntityType="ProjectService.Clients"/>
        <EntitySet Name="People" EntityType="ProjectService.People"/>
        <EntitySet Name="Currencies" EntityType="ProjectService.Currencies"/>
        <FunctionImport Name="me" Function="ProjectService.me"/>
        <FunctionImport Name="dashboard" Function="ProjectService.dashboard"/>
      </EntityContainer>

      <EntityType Name="Projects">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="code" Type="Edm.String" MaxLength="20"/>
        <Property Name="externalCode" Type="Edm.String" MaxLength="40"/>
        <Property Name="name" Type="Edm.String" MaxLength="200"/>
        <Property Name="description" Type="Edm.String" MaxLength="1000"/>
        <Property Name="projectType" Type="Edm.String" MaxLength="40"/>
        <Property Name="status" Type="Edm.String" MaxLength="20"/>
        <Property Name="startDate" Type="Edm.Date"/>
        <Property Name="endDate" Type="Edm.Date"/>
        <Property Name="value" Type="Edm.Decimal" Precision="15" Scale="2"/>
        <Property Name="currency_code" Type="Edm.String" MaxLength="3"/>
        <Property Name="client_ID" Type="Edm.Guid"/>
        <Property Name="pm_ID" Type="Edm.Guid"/>
        <Property Name="needsReview" Type="Edm.Boolean"/>
        <Property Name="reviewReason" Type="Edm.String" MaxLength="500"/>
        <Property Name="lastUpdateAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <NavigationProperty Name="client" Type="ProjectService.Clients">
          <ReferentialConstraint Property="client_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="pm" Type="ProjectService.Members">
          <ReferentialConstraint Property="pm_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="members" Type="Collection(ProjectService.Members)" Partner="project"/>
        <NavigationProperty Name="milestones" Type="Collection(ProjectService.Milestones)" Partner="project"/>
        <NavigationProperty Name="modules" Type="Collection(ProjectService.ProjectModules)" Partner="project"/>
        <NavigationProperty Name="updates" Type="Collection(ProjectService.Updates)" Partner="project"/>
        <NavigationProperty Name="attachments" Type="Collection(ProjectService.Attachments)" Partner="project"/>
      </EntityType>

      <!-- Status updates (US-27); the API's StatusUpdates. -->
      <EntityType Name="Updates">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="text" Type="Edm.String" MaxLength="2000"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="isAutomatic" Type="Edm.Boolean"/>
        <Property Name="author_ID" Type="Edm.Guid"/>
        <Property Name="postedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <NavigationProperty Name="project" Type="ProjectService.Projects" Partner="updates">
          <ReferentialConstraint Property="project_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="author" Type="ProjectService.People">
          <ReferentialConstraint Property="author_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <EntityType Name="Members">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="person_ID" Type="Edm.Guid"/>
        <Property Name="role" Type="Edm.String" MaxLength="40"/>
        <Property Name="startDate" Type="Edm.Date"/>
        <Property Name="endDate" Type="Edm.Date"/>
        <NavigationProperty Name="project" Type="ProjectService.Projects" Partner="members">
          <ReferentialConstraint Property="project_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="person" Type="ProjectService.People">
          <ReferentialConstraint Property="person_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <EntityType Name="Milestones">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="milestoneType" Type="Edm.String" MaxLength="40"/>
        <Property Name="sortOrder" Type="Edm.Int32"/>
        <Property Name="mandatory" Type="Edm.Boolean"/>
        <Property Name="requiresAudit" Type="Edm.Boolean"/>
        <Property Name="status" Type="Edm.String" MaxLength="20"/>
        <Property Name="forecastStart" Type="Edm.Date"/>
        <Property Name="forecastEnd" Type="Edm.Date"/>
        <Property Name="baselineStart" Type="Edm.Date"/>
        <Property Name="baselineEnd" Type="Edm.Date"/>
        <Property Name="actualDate" Type="Edm.Date"/>
        <Property Name="isEstimated" Type="Edm.Boolean"/>
        <Property Name="isOverdue" Type="Edm.Boolean"/>
        <Property Name="itemsCompletion" Type="Edm.Int32"/>
        <Property Name="justification" Type="Edm.String" MaxLength="500"/>
        <Property Name="changeReason" Type="Edm.String" MaxLength="500"/>
        <NavigationProperty Name="project" Type="ProjectService.Projects" Partner="milestones">
          <ReferentialConstraint Property="project_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="owners" Type="Collection(ProjectService.MilestoneOwners)" Partner="milestone"/>
        <NavigationProperty Name="audits" Type="Collection(ProjectService.Audits)" Partner="milestone"/>
        <NavigationProperty Name="items" Type="Collection(ProjectService.MilestoneItems)" Partner="milestone"/>
        <NavigationProperty Name="attachments" Type="Collection(ProjectService.Attachments)" Partner="milestone"/>
      </EntityType>

      <!-- Audits (US-24 to US-26, BR-10): only on the milestones that require
           one; an empty code is filled in by the API. -->
      <EntityType Name="Audits">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="code" Type="Edm.String" MaxLength="60"/>
        <Property Name="date" Type="Edm.Date"/>
        <Property Name="auditor_ID" Type="Edm.Guid"/>
        <Property Name="result" Type="Edm.String" MaxLength="30"/>
        <Property Name="notes" Type="Edm.String" MaxLength="2000"/>
        <NavigationProperty Name="milestone" Type="ProjectService.Milestones" Partner="audits">
          <ReferentialConstraint Property="milestone_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="auditor" Type="ProjectService.People">
          <ReferentialConstraint Property="auditor_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="followUps" Type="Collection(ProjectService.MilestoneItems)" Partner="audit"/>
      </EntityType>

      <!-- A milestone's items (US-21 to US-23); follow-ups are items of type
           FollowUp that point at the audit they came from. -->
      <EntityType Name="MilestoneItems">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="type" Type="Edm.String" MaxLength="20"/>
        <Property Name="name" Type="Edm.String" MaxLength="200"/>
        <Property Name="description" Type="Edm.String" MaxLength="1000"/>
        <Property Name="date" Type="Edm.Date"/>
        <Property Name="owner_ID" Type="Edm.Guid"/>
        <Property Name="status" Type="Edm.String" MaxLength="20"/>
        <Property Name="audit_ID" Type="Edm.Guid"/>
        <Property Name="isOverdue" Type="Edm.Boolean"/>
        <NavigationProperty Name="milestone" Type="ProjectService.Milestones" Partner="items">
          <ReferentialConstraint Property="milestone_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="owner" Type="ProjectService.People">
          <ReferentialConstraint Property="owner_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="audit" Type="ProjectService.Audits" Partner="followUps">
          <ReferentialConstraint Property="audit_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="attachments" Type="Collection(ProjectService.Attachments)" Partner="milestoneItem"/>
      </EntityType>

      <EntityType Name="MilestoneOwners">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="person_ID" Type="Edm.Guid"/>
        <NavigationProperty Name="milestone" Type="ProjectService.Milestones" Partner="owners">
          <ReferentialConstraint Property="milestone_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="person" Type="ProjectService.People">
          <ReferentialConstraint Property="person_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <EntityType Name="ProjectModules">
        <Key><PropertyRef Name="project_ID"/><PropertyRef Name="module"/></Key>
        <Property Name="project_ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="module" Type="Edm.String" MaxLength="20" Nullable="false"/>
        <NavigationProperty Name="project" Type="ProjectService.Projects" Partner="modules">
          <ReferentialConstraint Property="project_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <!-- O meu trabalho (US-13): the signed-in person's items and
           milestones, in any project, with the project flattened in. -->
      <EntityType Name="MyItems">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String"/>
        <Property Name="type" Type="Edm.String"/>
        <Property Name="status" Type="Edm.String"/>
        <Property Name="date" Type="Edm.Date"/>
        <Property Name="isOverdue" Type="Edm.Boolean"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="milestoneType" Type="Edm.String"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="MyMilestones">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="milestoneType" Type="Edm.String"/>
        <Property Name="status" Type="Edm.String"/>
        <Property Name="forecastEnd" Type="Edm.Date"/>
        <Property Name="isOverdue" Type="Edm.Boolean"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="Clients">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="200"/>
        <Property Name="taxId" Type="Edm.String" MaxLength="20"/>
        <Property Name="active" Type="Edm.Boolean"/>
      </EntityType>

      <EntityType Name="People">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="200"/>
        <Property Name="email" Type="Edm.String" MaxLength="200"/>
        <Property Name="profile" Type="Edm.String" MaxLength="20"/>
        <Property Name="active" Type="Edm.Boolean"/>
      </EntityType>

      <EntityType Name="Currencies">
        <Key><PropertyRef Name="code"/></Key>
        <Property Name="code" Type="Edm.String" MaxLength="3" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="60"/>
        <Property Name="symbol" Type="Edm.String" MaxLength="5"/>
      </EntityType>

      <!-- Dashboard's Últimas atualizações: updates across the projects the
           person may see, with the project and the author flattened in. -->
      <EntityType Name="RecentUpdates">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="author_ID" Type="Edm.Guid"/>
        <Property Name="postedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="text" Type="Edm.String"/>
        <Property Name="isAutomatic" Type="Edm.Boolean"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
        <Property Name="authorName" Type="Edm.String"/>
      </EntityType>

      <!-- Attachments (US-29, BR-11): a link on exactly one owner. -->
      <EntityType Name="Attachments">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="documentType" Type="Edm.String" MaxLength="40"/>
        <Property Name="name" Type="Edm.String" MaxLength="200"/>
        <Property Name="url" Type="Edm.String" MaxLength="1000"/>
        <Property Name="author_ID" Type="Edm.Guid"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="milestoneItem_ID" Type="Edm.Guid"/>
        <NavigationProperty Name="author" Type="ProjectService.People">
          <ReferentialConstraint Property="author_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="project" Type="ProjectService.Projects" Partner="attachments">
          <ReferentialConstraint Property="project_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="milestone" Type="ProjectService.Milestones" Partner="attachments">
          <ReferentialConstraint Property="milestone_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="milestoneItem" Type="ProjectService.MilestoneItems" Partner="attachments">
          <ReferentialConstraint Property="milestoneItem_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <!-- The Anexos page's view: every attachment, the project (projectID,
           as the API names it here), milestone and item flattened in. -->
      <EntityType Name="AllAttachments">
        <Key><PropertyRef Name="ID"/></Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="documentType" Type="Edm.String"/>
        <Property Name="name" Type="Edm.String"/>
        <Property Name="url" Type="Edm.String"/>
        <Property Name="author_ID" Type="Edm.Guid"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="milestoneItem_ID" Type="Edm.Guid"/>
        <Property Name="projectID" Type="Edm.Guid"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
        <Property Name="milestoneType" Type="Edm.String"/>
        <Property Name="module" Type="Edm.String"/>
        <Property Name="itemName" Type="Edm.String"/>
        <NavigationProperty Name="author" Type="ProjectService.People">
          <ReferentialConstraint Property="author_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <NavigationProperty Name="milestoneItem" Type="ProjectService.MilestoneItems">
          <ReferentialConstraint Property="milestoneItem_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
      </EntityType>

      <ComplexType Name="MonthCount">
        <Property Name="month" Type="Edm.String"/>
        <Property Name="created" Type="Edm.Int32"/>
        <Property Name="closed" Type="Edm.Int32"/>
      </ComplexType>

      <ComplexType Name="Me">
        <Property Name="ID" Type="Edm.Guid"/>
        <Property Name="name" Type="Edm.String"/>
        <Property Name="email" Type="Edm.String"/>
        <Property Name="profile" Type="Edm.String"/>
      </ComplexType>

      <ComplexType Name="StatusCount">
        <Property Name="status" Type="Edm.String"/>
        <Property Name="count" Type="Edm.Int32"/>
      </ComplexType>

      <ComplexType Name="OverdueMilestone">
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
        <Property Name="milestone_ID" Type="Edm.Guid"/>
        <Property Name="milestoneType" Type="Edm.String"/>
        <Property Name="dueDate" Type="Edm.Date"/>
        <Property Name="status" Type="Edm.String"/>
      </ComplexType>

      <ComplexType Name="ProjectRef">
        <Property Name="project_ID" Type="Edm.Guid"/>
        <Property Name="projectCode" Type="Edm.String"/>
        <Property Name="projectName" Type="Edm.String"/>
        <Property Name="clientName" Type="Edm.String"/>
        <Property Name="status" Type="Edm.String"/>
        <Property Name="reviewReason" Type="Edm.String"/>
        <Property Name="reviewRequestedAt" Type="Edm.DateTimeOffset"/>
        <Property Name="lastUpdateAt" Type="Edm.DateTimeOffset"/>
      </ComplexType>

      <ComplexType Name="Dashboard">
        <Property Name="staleDays" Type="Edm.Int32"/>
        <Property Name="projectsByStatus" Type="Collection(ProjectService.StatusCount)"/>
        <Property Name="overdueMilestones" Type="Collection(ProjectService.OverdueMilestone)"/>
        <Property Name="staleProjects" Type="Collection(ProjectService.ProjectRef)"/>
        <Property Name="projectsToReview" Type="Collection(ProjectService.ProjectRef)"/>
        <Property Name="projectsByMonth" Type="Collection(ProjectService.MonthCount)"/>
      </ComplexType>

      <Action Name="handOverPM" IsBound="true">
        <Parameter Name="in" Type="ProjectService.Projects"/>
        <Parameter Name="person_ID" Type="Edm.Guid"/>
        <Parameter Name="startDate" Type="Edm.Date"/>
      </Action>
      <Action Name="changeStatus" IsBound="true">
        <Parameter Name="in" Type="ProjectService.Projects"/>
        <Parameter Name="status" Type="Edm.String"/>
        <Parameter Name="reason" Type="Edm.String"/>
      </Action>
      <Action Name="setBaseline" IsBound="true">
        <Parameter Name="in" Type="ProjectService.Projects"/>
        <Parameter Name="reason" Type="Edm.String"/>
      </Action>
      <Action Name="addFollowUp" IsBound="true">
        <Parameter Name="in" Type="ProjectService.Audits"/>
        <Parameter Name="name" Type="Edm.String"/>
        <Parameter Name="owner_ID" Type="Edm.Guid"/>
        <Parameter Name="date" Type="Edm.Date"/>
        <Parameter Name="description" Type="Edm.String"/>
      </Action>
      <Function Name="me" IsBound="false">
        <ReturnType Type="ProjectService.Me"/>
      </Function>
      <Function Name="dashboard" IsBound="false">
        <Parameter Name="staleDays" Type="Edm.Int32"/>
        <Parameter Name="from" Type="Edm.Date"/>
        <Parameter Name="to" Type="Edm.Date"/>
        <ReturnType Type="ProjectService.Dashboard"/>
      </Function>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
